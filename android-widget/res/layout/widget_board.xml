<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical">
        <TextView android:id="@+id/heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_vertical" android:fontFamily="serif" android:textStyle="bold" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:text="東77" />
        <TextView android:id="@+id/settings" android:layout_width="32dp" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center" android:text="⚙" android:textSize="19sp" android:contentDescription="小工具設定" />
        <TextView android:id="@+id/refresh" android:layout_width="32dp" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center" android:text="↻" android:textSize="23sp" android:contentDescription="重新整理" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="14dp" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/feed" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:id="@+id/purchase" style="@style/Count" />
        <TextView android:id="@+id/shipment" style="@style/Count" />
        <TextView android:id="@+id/rules" style="@style/Count" />
        <TextView android:id="@+id/shortage" style="@style/Count" />
    </LinearLayout>
</LinearLayout>
