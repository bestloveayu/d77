<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="26dp" android:gravity="center_vertical">
    <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="serif" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/row_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="serif" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
