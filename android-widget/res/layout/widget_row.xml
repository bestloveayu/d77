<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/row_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/row_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginRight="10dp" android:src="@drawable/ic_task" android:contentDescription="" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/widget_serif_semibold" android:includeFontPadding="false" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/row_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/widget_serif" android:includeFontPadding="false" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/row_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:fontFamily="@font/widget_serif" android:includeFontPadding="false" android:textSize="10sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_line" android:layout_width="match_parent" android:layout_height="1dp" android:background="#D2DDD7" />
</LinearLayout>
